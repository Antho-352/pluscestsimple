{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Citrus Dark (lesdelicesdeb)",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "foreground",       "color": "#f5f1e8", "name": "Foreground" },
				{ "slug": "background",       "color": "#0a0a0a", "name": "Background" },
				{ "slug": "surface",          "color": "#1a1a1a", "name": "Surface" },
				{ "slug": "muted",            "color": "#8a8a8a", "name": "Muted" },
				{ "slug": "border",           "color": "#2a2a2a", "name": "Border" },
				{ "slug": "accent",           "color": "#ff2d00", "name": "Accent" },
				{ "slug": "accent-secondary", "color": "#caff00", "name": "Accent Secondary" },
				{ "slug": "accent-contrast",  "color": "#0a0a0a", "name": "Accent Contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "src": [ "file:./assets/fonts/inter-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Big Shoulders Display', 'Bebas Neue', 'Arial Narrow', Impact, sans-serif",
					"fontFace": [
						{ "fontFamily": "Big Shoulders Display", "fontStyle": "normal", "fontWeight": "100 900", "src": [ "file:./assets/fonts/big-shoulders-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "display-grotesk",
					"name": "Display Grotesk",
					"fontFamily": "'Space Grotesk', 'Inter', -apple-system, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "500 700", "src": [ "file:./assets/fonts/space-grotesk-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-secondary)",
						"text": "var(--wp--preset--color--accent-contrast)"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-secondary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			}
		}
	}
}
