{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Voyage (cuendet)",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "foreground",       "color": "#0d0d0d", "name": "Foreground" },
				{ "slug": "background",       "color": "#f5efe6", "name": "Background" },
				{ "slug": "surface",          "color": "#ebe3d4", "name": "Surface" },
				{ "slug": "muted",            "color": "#6e7a87", "name": "Muted" },
				{ "slug": "border",           "color": "#d5cab7", "name": "Border" },
				{ "slug": "accent",           "color": "#1e2d3d", "name": "Accent" },
				{ "slug": "accent-secondary", "color": "#c9622c", "name": "Accent Secondary" },
				{ "slug": "accent-contrast",  "color": "#f5efe6", "name": "Accent Contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "src": [ "file:./assets/fonts/inter-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Fraunces', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 900", "src": [ "file:./assets/fonts/fraunces-var.woff2" ], "fontDisplay": "swap" },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 900", "src": [ "file:./assets/fonts/fraunces-var-italic.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.15"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-secondary)",
						"text": "var(--wp--preset--color--accent-contrast)"
					}
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-secondary)" } }
			}
		}
	}
}
