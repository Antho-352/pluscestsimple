{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Brut (brutaliste doux)",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "foreground",       "color": "#141414", "name": "Foreground" },
				{ "slug": "background",       "color": "#ebe7e0", "name": "Background" },
				{ "slug": "surface",          "color": "#dcd6cb", "name": "Surface" },
				{ "slug": "muted",            "color": "#6c6c6c", "name": "Muted" },
				{ "slug": "border",           "color": "#141414", "name": "Border" },
				{ "slug": "accent",           "color": "#d4593a", "name": "Accent (terracotta)" },
				{ "slug": "accent-secondary", "color": "#3a4a55", "name": "Accent secondary (ardoise)" },
				{ "slug": "accent-contrast",  "color": "#ebe7e0", "name": "Accent contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "src": [ "file:./assets/fonts/inter-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Space Grotesk', 'Inter', -apple-system, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "500 700", "src": [ "file:./assets/fonts/space-grotesk-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.0",
					"letterSpacing": "-0.025em",
					"textTransform": "uppercase"
				}
			},
			"h1": { "typography": { "fontWeight": "700", "letterSpacing": "-0.035em" } },
			"h2": { "typography": { "fontWeight": "700", "letterSpacing": "-0.03em" } },
			"h3": { "typography": { "fontWeight": "600", "letterSpacing": "-0.02em" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--foreground)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "0",
					"width": "2px",
					"style": "solid",
					"color": "var(--wp--preset--color--foreground)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"letterSpacing": "0.02em",
					"textTransform": "uppercase",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "1.5rem",
						"bottom": "1rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--accent-contrast)"
					},
					"border": { "color": "var(--wp--preset--color--accent)" }
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--foreground)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "background": "var(--wp--preset--color--foreground)" },
				"css": "&:not(.is-style-wide):not(.is-style-dots){max-width:none;border-bottom-width:2px;}"
			},
			"core/quote": {
				"border": {
					"left": { "width": "3px", "color": "var(--wp--preset--color--accent)" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--lg)",
					"lineHeight": "1.3",
					"textTransform": "none",
					"letterSpacing": "-0.01em"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--foreground)", "text": "var(--wp--preset--color--accent-contrast)" },
				"border": { "radius": "0" }
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.0"
				}
			},
			"core/image": {
				"border": { "radius": "0" }
			}
		}
	}
}
