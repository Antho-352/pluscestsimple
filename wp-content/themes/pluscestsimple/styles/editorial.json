{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Editorial (art déco moderne)",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "foreground",       "color": "#0c0e0d", "name": "Foreground" },
				{ "slug": "background",       "color": "#f7f1e6", "name": "Background" },
				{ "slug": "surface",          "color": "#efe7d3", "name": "Surface" },
				{ "slug": "muted",            "color": "#5b5648", "name": "Muted" },
				{ "slug": "border",           "color": "#d8cbb0", "name": "Border" },
				{ "slug": "accent",           "color": "#1f3a2e", "name": "Accent (vert anglais)" },
				{ "slug": "accent-secondary", "color": "#a78a4d", "name": "Accent secondary (laiton)" },
				{ "slug": "accent-contrast",  "color": "#f7f1e6", "name": "Accent contrast" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "src": [ "file:./assets/fonts/inter-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Fraunces', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 900", "src": [ "file:./assets/fonts/fraunces-var.woff2" ], "fontDisplay": "swap" },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 900", "src": [ "file:./assets/fonts/fraunces-var-italic.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"lineHeight": "1.75",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontWeight": "300", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontWeight": "300", "fontSize": "var(--wp--preset--font-size--3xl)", "letterSpacing": "-0.02em" } },
			"h3": { "typography": { "fontWeight": "400", "fontSize": "var(--wp--preset--font-size--2xl)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "0",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"fontWeight": "500",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase",
					"fontSize": "var(--wp--preset--font-size--xs)"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"right": "1.75rem",
						"bottom": "0.95rem",
						"left": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-secondary)",
						"text": "var(--wp--preset--color--foreground)"
					},
					"border": { "color": "var(--wp--preset--color--accent-secondary)" }
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-secondary)" },
					"typography": { "textDecoration": "none" }
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "background": "var(--wp--preset--color--accent-secondary)" },
				"css": "&:not(.is-style-wide):not(.is-style-dots){max-width:80px;border-bottom-width:1px;}"
			},
			"core/quote": {
				"border": {
					"left": { "width": "0", "color": "transparent" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontStyle": "italic",
					"fontWeight": "300",
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.4"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--60)",
						"right": "0",
						"bottom": "var(--wp--preset--spacing--60)",
						"left": "0"
					}
				},
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "300",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.05"
				}
			}
		}
	}
}
