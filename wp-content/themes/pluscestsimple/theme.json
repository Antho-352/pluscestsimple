{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "foreground", "color": "#0a0a0a", "name": "Foreground" },
        { "slug": "background", "color": "#ffffff", "name": "Background" },
        { "slug": "surface", "color": "#f6f6f4", "name": "Surface" },
        { "slug": "muted", "color": "#6b6b6b", "name": "Muted" },
        { "slug": "border", "color": "#e5e5e5", "name": "Border" },
        { "slug": "accent", "color": "#0066ff", "name": "Accent" },
        { "slug": "accent-contrast", "color": "#ffffff", "name": "Accent Contrast" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif"
        },
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.75rem", "fluid": false, "name": "XS" },
        { "slug": "sm", "size": "0.875rem", "fluid": false, "name": "SM" },
        { "slug": "base", "size": "1rem", "fluid": { "min": "1rem", "max": "1.0625rem" }, "name": "Base" },
        { "slug": "md", "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" }, "name": "MD" },
        { "slug": "lg", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.625rem" }, "name": "LG" },
        { "slug": "xl", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.25rem" }, "name": "XL" },
        { "slug": "2xl", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "2XL" },
        { "slug": "3xl", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.25rem" }, "name": "3XL" },
        { "slug": "4xl", "size": "5rem", "fluid": { "min": "3rem", "max": "5.5rem" }, "name": "4XL" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "size": "0.25rem", "name": "1" },
        { "slug": "20", "size": "0.5rem", "name": "2" },
        { "slug": "30", "size": "0.75rem", "name": "3" },
        { "slug": "40", "size": "1rem", "name": "4" },
        { "slug": "50", "size": "1.5rem", "name": "5" },
        { "slug": "60", "size": "2rem", "name": "6" },
        { "slug": "70", "size": "3rem", "name": "7" },
        { "slug": "80", "size": "4rem", "name": "8" },
        { "slug": "90", "size": "6rem", "name": "9" },
        { "slug": "100", "size": "8rem", "name": "10" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "radius": {
        "none": "0",
        "sm": "4px",
        "md": "8px",
        "lg": "16px",
        "pill": "999px"
      },
      "transition": {
        "fast": "120ms cubic-bezier(0.2, 0, 0, 1)",
        "base": "200ms cubic-bezier(0.2, 0, 0, 1)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--50)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--3xl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--2xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--foreground)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": { "radius": "var(--wp--custom--radius--sm)" },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.25rem",
            "bottom": "0.75rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "textDecoration": "none"
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--2xl)" }
      },
      "core/separator": {
        "color": { "background": "var(--wp--preset--color--border)" }
      },
      "core/quote": {
        "border": { "left": { "width": "3px", "color": "var(--wp--preset--color--accent)" } },
        "spacing": { "padding": { "left": "var(--wp--preset--spacing--50)" } },
        "typography": { "fontStyle": "normal" }
      },
      "core/code": {
        "color": { "background": "var(--wp--preset--color--surface)" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--sm)" },
        "spacing": { "padding": "var(--wp--preset--spacing--40)" },
        "border": { "radius": "var(--wp--custom--radius--sm)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "post-meta", "title": "Post meta", "area": "uncategorized" },
    { "name": "related", "title": "Related posts", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-media-kit", "title": "Kit média", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] },
    { "name": "page-legal", "title": "Mentions légales", "postTypes": ["page"] },
    { "name": "page-sitemap", "title": "Plan du site", "postTypes": ["page"] },
    { "name": "page-thank-you", "title": "Page de remerciement", "postTypes": ["page"] },
    { "name": "page-wide", "title": "Pleine largeur", "postTypes": ["page"] },
    { "name": "single-review", "title": "Review produit (affiliation)", "postTypes": ["post"] },
    { "name": "single-comparison", "title": "Comparatif (affiliation)", "postTypes": ["post"] }
  ]
}
