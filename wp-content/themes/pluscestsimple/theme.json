{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "foreground",       "color": "#0c0e0d", "name": "Texte" },
				{ "slug": "background",       "color": "#f7f1e6", "name": "Fond" },
				{ "slug": "surface",          "color": "#efe7d3", "name": "Surface" },
				{ "slug": "muted",            "color": "#5b5648", "name": "Texte secondaire" },
				{ "slug": "border",           "color": "#d8cbb0", "name": "Bordure" },
				{ "slug": "accent",           "color": "#1f3a2e", "name": "Accent vert" },
				{ "slug": "accent-secondary", "color": "#a78a4d", "name": "Accent laiton" },
				{ "slug": "accent-contrast",  "color": "#f7f1e6", "name": "Contraste accent" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "300 700", "src": [ "file:./assets/fonts/inter-var.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Fraunces', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 900", "src": [ "file:./assets/fonts/fraunces-var.woff2" ], "fontDisplay": "swap" },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 900", "src": [ "file:./assets/fonts/fraunces-var-italic.woff2" ], "fontDisplay": "swap" }
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "xs",   "size": "0.6875rem", "fluid": false, "name": "XS" },
				{ "slug": "sm",   "size": "0.8125rem", "fluid": false, "name": "SM" },
				{ "slug": "base", "size": "0.875rem",  "fluid": { "min": "0.875rem", "max": "0.9375rem" }, "name": "Base" },
				{ "slug": "md",   "size": "1rem",      "fluid": { "min": "0.9375rem", "max": "1.0625rem" }, "name": "MD" },
				{ "slug": "lg",   "size": "1.5rem",   "fluid": { "min": "1.25rem", "max": "1.625rem" }, "name": "LG" },
				{ "slug": "xl",   "size": "2rem",     "fluid": { "min": "1.625rem", "max": "2.25rem" }, "name": "XL" },
				{ "slug": "2xl",  "size": "2.75rem",  "fluid": { "min": "2rem", "max": "3rem" }, "name": "2XL" },
				{ "slug": "3xl",  "size": "3.75rem",  "fluid": { "min": "2.5rem", "max": "4.25rem" }, "name": "3XL" },
				{ "slug": "4xl",  "size": "5rem",     "fluid": { "min": "3rem", "max": "5.5rem" }, "name": "4XL" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "size": "0.25rem", "name": "1" },
				{ "slug": "20", "size": "0.5rem",  "name": "2" },
				{ "slug": "30", "size": "0.75rem", "name": "3" },
				{ "slug": "40", "size": "1rem",    "name": "4" },
				{ "slug": "50", "size": "1.5rem",  "name": "5" },
				{ "slug": "60", "size": "2rem",    "name": "6" },
				{ "slug": "70", "size": "3rem",    "name": "7" },
				{ "slug": "80", "size": "4rem",    "name": "8" },
				{ "slug": "90", "size": "6rem",    "name": "9" }
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"custom": {
			"radius":     { "none": "0", "sm": "4px", "md": "8px", "lg": "16px", "pill": "999px" },
			"transition": { "fast": "160ms cubic-bezier(0.2, 0, 0, 1)", "base": "260ms cubic-bezier(0.2, 0, 0, 1)" }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.15",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontWeight": "300", "fontSize": "var(--wp--preset--font-size--3xl)", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontWeight": "300", "fontSize": "var(--wp--preset--font-size--2xl)", "letterSpacing": "-0.02em" } },
			"h3": { "typography": { "fontWeight": "400", "fontSize": "var(--wp--preset--font-size--xl)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-secondary)" },
					"typography": { "textDecoration": "none" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--accent)" },
				"typography": { "fontWeight": "500", "letterSpacing": "0.04em", "textTransform": "uppercase", "fontSize": "var(--wp--preset--font-size--xs)" },
				"spacing": { "padding": { "top": "0.95rem", "right": "1.75rem", "bottom": "0.95rem", "left": "1.75rem" } },
				":hover": {
					"color": { "background": "var(--wp--preset--color--accent-secondary)", "text": "var(--wp--preset--color--foreground)" },
					"border": { "color": "var(--wp--preset--color--accent-secondary)" }
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "background": "var(--wp--preset--color--accent-secondary)" },
				"css": "&:not(.is-style-wide):not(.is-style-dots){max-width:80px;border-bottom-width:1px;}"
			},
			"core/quote": {
				"border": { "left": { "width": "0", "color": "transparent" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontStyle": "italic", "fontWeight": "300", "fontSize": "var(--wp--preset--font-size--xl)", "lineHeight": "1.4" },
				"color": { "text": "var(--wp--preset--color--accent)" },
				"spacing": { "padding": { "top": "var(--wp--preset--spacing--60)", "right": "0", "bottom": "var(--wp--preset--spacing--60)", "left": "0" } }
			}
		}
	}
}
