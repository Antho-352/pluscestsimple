# Block direct access to bundled PDF.
# The PDF is auto-copied to wp-content/uploads/arw-maison/private/ on plugin activation.
# Visitors must download via REST /arw/v1/lead-download with a valid token.

<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
